# AgentLite Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================================
# OpenAI (Default Provider)
# ============================================================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1  # Optional: custom endpoint

# ============================================================================
# Cleanlab TLM (For TrustworthyAgent)
# ============================================================================
# Get your free key from: https://tlm.cleanlab.ai/
CLEANLAB_TLM_API_KEY=...

# ============================================================================
# OpenRouter (NEW - Unified API for 100+ models)
# ============================================================================
# Get your key from: https://openrouter.ai/keys
# Supports: Anthropic Claude, Meta Llama, Google Gemini, and many more
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1  # Optional: custom endpoint

# ============================================================================
# DeepSeek (NEW - High-performance models)
# ============================================================================
# Get your key from: https://platform.deepseek.com/api_keys
# Models: deepseek-chat, deepseek-coder, deepseek-reasoner
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_BASE=https://api.deepseek.com  # Optional: custom endpoint

# ============================================================================
# Notes:
# ============================================================================
# 1. Remove the '#' to uncomment a line
# 2. Never commit this file with real API keys to version control
# 3. See docs/ALTERNATIVE_LLM_PROVIDERS.md for detailed setup instructions
# 4. You only need to set keys for providers you plan to use
